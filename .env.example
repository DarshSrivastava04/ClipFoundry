# Copy to .env.local and fill in. Never commit .env.local.

# Public (safe for browser). Found in Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never import in client code.
# Bypasses Row Level Security; used only for trusted server-side operations.
SUPABASE_SERVICE_ROLE_KEY=
